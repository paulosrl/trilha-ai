#!/usr/bin/env bash
# A trava do commit (em trilha/, copiada sem mudar; ligada por: git config core.hooksPath
# trilha/hooks). Antes de cada commit, as regras e o método, que são rápidos. A stack e os testes
# ficam no scripts/check.sh e no CI: o teste que falha antes do código precisa poder ir num
# commit. O aviso do plugin, que espera o Claude Code responder, também fica no check.sh.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
python3 -I trilha/confere_regras.py . >/dev/null
python3 -I trilha/confere_metodo.py --sem-plugin >/dev/null
